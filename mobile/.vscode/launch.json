{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile: Multi-role (test API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=${input:mobileApiUrl}"
      ]
    },
    {
      "name": "Mobile: Rider (test API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/rider_main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=${input:mobileApiUrl}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "mobileApiUrl",
      "type": "promptString",
      "description": "Test API URL ending in /api/v1 (10.0.2.2 is for an Android emulator)",
      "default": "http://10.0.2.2:8000/api/v1"
    }
  ]
}
